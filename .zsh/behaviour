#!/bin/bash

# Pager
# export LESS='-R --mouse' # --mouse breaks selection? scroll still works without it
export LESS='-R'
export LESSOPEN="|/opt/homebrew/bin/lesspipe.sh %s"

# Colorful ls (BSD uses LSCOLORS + -G, GNU uses LS_COLORS + --color)
export LSCOLORS="Gxfxcxdxbxegedabagacad"
if (( $+commands[dircolors] )); then
  source <(dircolors -b)
else
  export LS_COLORS="di=1;36:ln=35:so=32:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"
fi
if [[ "$OSTYPE" == darwin* ]]; then
  alias ls='ls -G'
elif ls --color=tty &>/dev/null; then
  alias ls='ls --color=tty'
fi

# Key bindings
bindkey -e
autoload -U edit-command-line
zle -N edit-command-line
bindkey '\C-x\C-e' edit-command-line

if [[ -n "${terminfo[khome]}" ]]; then
  bindkey "${terminfo[khome]}" beginning-of-line
fi
if [[ -n "${terminfo[kend]}" ]]; then
  bindkey "${terminfo[kend]}" end-of-line
fi
if [[ -n "${terminfo[kdch1]}" ]]; then
  bindkey "${terminfo[kdch1]}" delete-char
fi
bindkey "\e[1;3C" forward-word
bindkey "\e[1;3D" backward-word

# Reasonable ctrl+w, see https://github.com/ohmyzsh/ohmyzsh/issues/8743
WORDCHARS=''

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt share_history

# Shell options
setopt auto_pushd
setopt pushd_ignore_dups
setopt pushdminus
setopt multios
setopt long_list_jobs
setopt interactivecomments
setopt no_beep

# URL paste safety
if [[ -e "${fpath[(r)*/url-quote-magic]}" ]]; then
  autoload -Uz bracketed-paste-magic url-quote-magic
  zle -N bracketed-paste bracketed-paste-magic
  zle -N self-insert url-quote-magic
fi
